{
  "name": "3d_objects",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "baseline:capture": "node Tools/BaselineCapture/capture.mjs",
    "baseline:capture:browser": "playwright test --config Tools/BaselineCapture/playwright.capture.config.js",
    "baseline:capture:environment": "node Tools/BaselineCapture/capture-environment.mjs",
    "baseline:matrix": "node Tools/BaselineCapture/generate-parity-matrix.mjs",
    "baseline:verify:reference": "node Tools/BaselineCapture/verify-reference.mjs",
    "baseline:check": "node Tools/BaselineCapture/capture.mjs --check",
    "godot:content:extract": "node Tools/GodotContentExtraction/extract-content.mjs --write",
    "godot:content:check": "node Tools/GodotContentExtraction/extract-content.mjs --check",
    "godot:phase2:audit": "node Tools/Phase2Audit/validate-audit.mjs",
    "godot:phase3:audit": "node Tools/Phase3Audit/validate-audit.mjs",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "verify": "npm run test:unit && npm run build && npm run test:browser",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "gh-pages": "^6.3.0",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.185.1"
  }
}
