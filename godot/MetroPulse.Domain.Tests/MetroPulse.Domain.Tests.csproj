<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MetroPulse.Domain.Tests</RootNamespace>
    <AssemblyName>MetroPulse.Domain.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MetroPulse.Domain/MetroPulse.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../test/fixtures/godot-port/phase0/game-state.json"
                      Link="Fixtures/game-state.json"
                      LogicalName="MetroPulse.Domain.Tests.Fixtures.game-state.json" />
    <EmbeddedResource Include="../../test/fixtures/godot-port/phase0/content-registry.json"
                      Link="Fixtures/content-registry.json"
                      LogicalName="MetroPulse.Domain.Tests.Fixtures.content-registry.json" />
    <EmbeddedResource Include="../../test/fixtures/godot-port/phase0/world-landmarks.json"
                      Link="Fixtures/world-landmarks.json"
                      LogicalName="MetroPulse.Domain.Tests.Fixtures.world-landmarks.json" />
    <EmbeddedResource Include="../../test/fixtures/godot-port/phase0/seeded-agents-navigation.json"
                      Link="Fixtures/seeded-agents-navigation.json"
                      LogicalName="MetroPulse.Domain.Tests.Fixtures.seeded-agents-navigation.json" />
    <EmbeddedResource Include="../../test/fixtures/godot-port/phase0/economy.json"
                      Link="Fixtures/economy.json"
                      LogicalName="MetroPulse.Domain.Tests.Fixtures.economy.json" />
  </ItemGroup>
</Project>
